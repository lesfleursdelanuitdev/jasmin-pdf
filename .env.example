# Public HTTPS URL of this app (Shopify loads the snippet and sends webhooks here)
APP_URL=http://localhost:8000

# Admin (HTTP Basic auth) - change these!
ADMIN_USER=admin
ADMIN_PASSWORD=jasmin

# Where templates, uploads, proofs and print files are stored
JASMIN_DATA_DIR=./data

# Optional: Postgres instead of the SQLite file in JASMIN_DATA_DIR.
# DATABASE_URL is used by the app (a pooled address is fine);
# DATABASE_URL_UNPOOLED, a direct connection, is used to create the tables.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Optional: keep the files (template PDFs, photos, proofs, print files) in a
# private Supabase Storage bucket as well. JASMIN_DATA_DIR stays the working
# copy; anything missing from it is fetched from the bucket when needed.
# The secret key is the project's secret (service role) key: keep it private.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=jasmin

# Shopify
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
# Signing secret shown under Settings > Notifications > Webhooks
SHOPIFY_WEBHOOK_SECRET=
# Optional: custom app Admin API token (write_orders) to tag orders
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07
# Custom storefront domains allowed to embed the editor, comma separated
STOREFRONT_ORIGINS=https://www.your-shop.com

# Local mock storefront at /demo-store
DEMO_STORE=true
# Max resolution of photos embedded in print files
PRINT_MAX_DPI=300

# Admin sign-in with Supabase Auth instead of ADMIN_USER / ADMIN_PASSWORD. Used when
# SUPABASE_URL, the publishable key and at least one address are set. Only these
# addresses may sign in to /admin. SESSION_SECRET signs the session cookie
# (any long random text, e.g. `openssl rand -hex 32`).
# SUPABASE_PUBLISHABLE_KEY=
# ADMIN_EMAILS=
# SESSION_SECRET=

# Backups: a zip of the database and every stored file. Made from the admin
# (Backups) or with `python -m scripts.backup`; with BACKUP_AUTO also once a day.
# JASMIN_DATA_DIR/backups unless BACKUP_DIR is set; the newest BACKUP_KEEP are kept.
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BACKUP_AUTO=true
# BACKUP_HOUR_UTC=3

# The store's Jasmin app (made in the store's Dev Dashboard; see README, "Connect a
# Shopify store"). With the client id and secret the app gets its own Admin API token
# and checks incoming webhooks; SHOPIFY_WEBHOOK_SECRET and SHOPIFY_ADMIN_TOKEN are then not needed.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
